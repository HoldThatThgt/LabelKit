{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "examples": [{"request": {"status": "blocked", "acknowledged": true}, "ticket": {"id": null, "status": "not_issued"}}],
  "properties": {
    "request": {
      "type": "object",
      "properties": {"status": {"const": "blocked"}, "acknowledged": {"const": true}},
      "required": ["status", "acknowledged"]
    },
    "ticket": {
      "type": "object",
      "properties": {"id": {"type": "null"}, "status": {"const": "not_issued"}},
      "required": ["id", "status"]
    }
  },
  "required": ["request", "ticket"]
}
