{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["region_id", "label", "bbox"],
        "properties": {
          "region_id": {"type": "string", "x-labelkit-region-ref": true},
          "label": {"type": "string"},
          "bbox": {
            "x-labelkit-postprocessor": true,
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {"type": "number"}
          }
        }
      }
    }
  }
}
